#WAP to teacher is taking attendence and everytime he needs to enter present or absent the total strength is 30. calculate the total No. of students absent or present

present = 0
absent = 0

for i in range(1, 31):
    status = input(f"Enter attendance for student {i} (P for Present / A for Absent): ")

    if status == "P" or status == "p":
        present = present + 1
    elif status == "A" or status == "a":
        absent =  absent + 1
    else:
        print("Invalid input")

print("Total Present Students =", present)
print("Total Absent Students =", absent)
